{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brauchwasserwärmepumpen-Datensatz",
  "type": "object",
  "required": ["stand", "scop_faktor", "modelle"],
  "properties": {
    "stand": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scop_faktor": { "type": "number", "exclusiveMinimum": 0 },
    "quellen_hinweis": { "type": "string" },
    "modelle": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modell" }
    }
  },
  "$defs": {
    "zahlOderNull": { "type": ["number", "null"] },
    "textOderNull": { "type": ["string", "null"] },
    "modell": {
      "type": "object",
      "required": ["id", "name", "marke", "bauart", "volumen_l"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 3 },
        "marke": { "type": "string", "minLength": 2 },
        "bauart": { "enum": ["bodenstehend", "wandhaengend", "ohne_kessel", "split"] },
        "waermeleistung_kw": { "$ref": "#/$defs/zahlOderNull" },
        "waermeleistung": { "$ref": "#/$defs/textOderNull" },
        "el_leistung_kw": { "$ref": "#/$defs/zahlOderNull" },
        "el_leistung": { "$ref": "#/$defs/textOderNull" },
        "ww_max_c": { "type": ["number", "null"], "minimum": 20, "maximum": 90 },
        "luft_min_c": { "type": ["number", "null"], "minimum": -30, "maximum": 40 },
        "luft_max_c": { "type": ["number", "null"], "minimum": 0, "maximum": 50 },
        "luftvolumen_m3h": { "type": ["number", "null"], "minimum": 0, "maximum": 5000 },
        "luftvolumen": { "$ref": "#/$defs/textOderNull" },
        "abmessung_mm": { "$ref": "#/$defs/textOderNull" },
        "gewicht_kg": { "type": ["number", "null"], "minimum": 0, "maximum": 500 },
        "volumen_l": { "type": ["number", "null"], "minimum": 0, "maximum": 2000 },
        "eta_wh": { "type": ["number", "null"], "minimum": 30, "maximum": 400 },
        "eff_klasse": { "enum": ["A+++", "A++", "A+", "A", "B", "C", "D", "E", "F", "G", null] },
        "schallleistung_db": { "type": ["number", "null"], "minimum": 20, "maximum": 90 },
        "bereitschaftsverlust_kwh_tag": { "$ref": "#/$defs/zahlOderNull" },
        "kaeltemittel": { "$ref": "#/$defs/textOderNull" },
        "preis_eur": { "type": ["number", "null"], "minimum": 0 },
        "heizstab_w": { "type": ["number", "null"], "minimum": 0, "maximum": 20000 },
        "kessel_material": { "$ref": "#/$defs/textOderNull" },
        "anode": { "$ref": "#/$defs/textOderNull" },
        "ehpa_guetesiegel": { "$ref": "#/$defs/textOderNull" },
        "quelle": { "$ref": "#/$defs/textOderNull" },
        "cop_a7": { "type": ["number", "null"], "minimum": 1, "maximum": 8 },
        "cop_a14": { "type": ["number", "null"], "minimum": 1, "maximum": 8 },
        "cop_a15": { "type": ["number", "null"], "minimum": 1, "maximum": 8 },
        "cop_a20": { "type": ["number", "null"], "minimum": 1, "maximum": 8 },
        "cop_unspezifisch": { "type": ["number", "null"], "minimum": 1, "maximum": 8 },
        "scop_basis": {
          "enum": ["eta_wh", "cop_a7", "cop_a14", "cop_a15", "cop_a20", "cop_unspezifisch", null]
        },
        "scop_tabelle": { "$ref": "#/$defs/zahlOderNull" },
        "waermetauscher": {
          "type": "object",
          "properties": {
            "vorhanden": { "type": ["boolean", "null"] },
            "variante": { "$ref": "#/$defs/textOderNull" },
            "flaeche_m2": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
          }
        }
      }
    }
  }
}
